#############################################
# BUILD STEP 1 (if using GPUs with TensorRT)
#############################################
UBUNTU_IMAGE_VERSION=20.04
CUDA_VERSION=12.5.0 # nvidia-smi
CUDA_ARCH_BIN=7.5 # search for "CUDA GPU Compute Capability"
OPENCV_VERSION=4.10.0
TAG1=multicamstudio
CMAKE_VERSION=3.27.7 # worked with this value
CPP_OPTIMIZATIONS="-DNDEBUG -O3 -march=skylake-avx512 -mtune=skylake-avx512 -Wno-deprecated-declarations"
#############################################
FLIR_CAMERA_COUNT=5
FLIR_GID=1001 # getent group | grep flir
CAMERA_SETTINGS_FILE="/home/docker/workspace/cfg/camera_settings_1024x768.json"
EYE_TRACKER_SETTINGS_FILE="/home/docker/workspace/cfg/eye_tracker_settings.json"
CAMERA_CALIBRATION_FILE="/home/docker/workspace/cfg/CameraCalibrationSettings.json"
CALIBRATION_DATA="/home/docker/workspace/data"
PORT=5173

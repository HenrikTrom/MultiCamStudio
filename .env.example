# One-time configuration for a new host. Copy to .env and adjust as needed.
# Match file ownership to the host account (id -u / id -g).
UID=1000
GID=1000

# GUI and persistent host directories. Both directories must already exist.
PORT=5173
MCS_CONFIG_DIR=./cfg
MCS_DATA_DIR=./data
TZ=Europe/Berlin

# ROS publishers run separately; match their domain and topic names.
ROS_DISTRO=jazzy
ROS_DOMAIN_ID=97
ROS_AUTOMATIC_DISCOVERY_RANGE=SUBNET
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
FASTDDS_BUILTIN_TRANSPORTS=UDPv4
ROS_IMAGE_TOPIC_TEMPLATE=/grasshopper/camera_{serial}/image_raw

# Preview limit is always 30 Hz. Use the GPU Compose override for NVENC.
STREAMER_PORT=8080
STREAMER_BITRATE_MBIT=4
STREAMER_ENCODER=libx264
# The GPU Compose override selects hevc_nvenc for previews despite this CPU
# default. To override the preview encoder in GPU mode, uncomment:
# GPU_STREAMER_ENCODER=libx264

# ROS bag recording and synchronized PNG capture. Camera IDs live in cfg JSON.
RECORD_SYNC_TOLERANCE_MS=5
CALIBRATION_CAPTURE_FRAMES=30
CALIBRATION_CAPTURE_INTERVAL_MS=500
CALIBRATION_MAX_REPROJECTION_ERROR_PX=5

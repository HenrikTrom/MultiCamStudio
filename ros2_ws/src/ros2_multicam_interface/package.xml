<?xml version="1.0"?>
<package format="3">
  <name>ros2_multicam_interface</name>
  <version>0.1.0</version>
  <description>ROS 2 image subscriptions and low latency browser previews for MultiCamStudio.</description>
  <maintainer email="henrik.trommer@uni-goettingen.de">Henrik Trommer</maintainer>
  <license>LicenseRef-Unspecified</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>nlohmann-json-dev</depend>
  <depend>spdlog</depend>
  <depend>libavcodec-dev</depend>
  <depend>libavformat-dev</depend>
  <depend>libavutil-dev</depend>
  <depend>libswscale-dev</depend>
  <depend>opencv</depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
